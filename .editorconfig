root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
tab_width = 2
max_line_length = 120
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
# Two trailing spaces are a line break in Markdown.
trim_trailing_whitespace = false

[*.pbxproj]
# Generated by Xcode, which writes tabs.
indent_style = tab
max_line_length = off
